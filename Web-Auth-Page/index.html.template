<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Network Login</title>
    <!-- Icons load karaganna FontAwesome link eka -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

      body {
            display: flex;
            justify-content: center;
            align-items: center;
            
            min-height: 100vh;
            
            /* Methana thamai wenas wenne */
            background-image: url('campus-photo.jpg'); /* Oyage photo eke nama danna */
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        .login-card {
            background-color: #fff;
            width: 400px;
            padding: 50px 40px;
            border-radius: 10px;
            box-shadow: 0 15px 25px rgba(0,0,0,0.1);
            text-align: center;
        }

        .login-card h2 {
            font-size: 30px;
            color: #333;
            margin-bottom: 30px;
            font-weight: 700;
        }

        .input-group {
            text-align: left;
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            font-size: 12px;
            color: #666;
            margin-bottom: 5px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            color: #ccc;
            font-size: 14px;
        }

        .input-wrapper input {
            width: 100%;
            padding: 10px 10px 10px 25px;
            border: none;
            border-bottom: 1px solid #e0e0e0;
            outline: none;
            font-size: 14px;
            color: #333;
            transition: border-color 0.3s;
        }

        .input-wrapper input:focus {
            border-bottom: 1px solid #a020f0;
        }

        .input-wrapper input::placeholder {
            color: #aaa;
            font-weight: 300;
        }

        .forgot-pass {
            text-align: right;
            margin-top: -10px;
            margin-bottom: 20px;
        }

        .forgot-pass a {
            font-size: 12px;
            color: #666;
            text-decoration: none;
        }

        .forgot-pass a:hover {
            color: #a020f0;
        }

        .login-btn {
            width: 100%;
            padding: 12px;
            background: linear-gradient(to right, #00d2ff, #a020f0);
            border: none;
            border-radius: 25px;
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 1px;
            margin-bottom: 30px;
            transition: opacity 0.3s;
        }

        .login-btn:hover {
            opacity: 0.9;
        }

        .social-text {
            font-size: 12px;
            color: #666;
            margin-bottom: 15px;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .social-icons a {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        .social-icons .fb { background-color: #3b5998; }
        .social-icons .tw { background-color: #1da1f2; }
        .social-icons .go { background-color: #ea4335; }

        .signup-text {
            font-size: 12px;
            color: #666;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .signup-text a {
            color: #333;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
        }

        .signup-text a:hover {
            color: #a020f0;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <h2 style="font-size: 24px; margin-bottom: 5px; color: #333;">${Logging}</h2>
<p style="font-size: 13px; color: #888; margin-bottom: 25px;">${Campus_Name}</p>

        <!-- Switch ekata submit wena form eka -->
        <form method="post" action="https://${SWITCH_IP}:${SWITCH_PORT}/login.html">
            <input type="hidden" name="buttonClicked" value="4">

            <div class="input-group">
                <label>${Email_or_EDU_ID}</label>
                <div class="input-wrapper">
                    <i class="far fa-user"></i>
                    <input type="email" name="email" placeholder="Type your email" required>
                </div>
            </div>

            <div class="input-group">
                <label>Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" placeholder="Type your password" required>
                </div>
            </div>

            <div class="forgot-pass">
                <!-- LDAP Password Reset Link Eka -->
                <a href="http://${PASSWORD_RESET_PORTAL_LINK}:${PASSWORD_RESET_PORTAL_PORT}">Forgot password?</a>
            </div>

            <button type="submit" class="login-btn">LOGIN</button>
        </form>


        <div class="signup-text">
            
            <a href="http://${SIGNUP_PORTAL_LINK}:${SIGNUP_PORTAL_PORT}">SIGN UP</a>
        </div>
    </div>

</body>
</html>